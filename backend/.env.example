PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/syncspace
REDIS_URL=redis://localhost:6379

# Set REDIS_REQUIRED=true to enforce strict multi-instance distributed mode (required in production).
# In development (REDIS_REQUIRED=false or unset), SyncSpace runs in standalone mode using an in-memory
# Socket.IO adapter if Redis is unavailable.
REDIS_REQUIRED=false

JWT_SECRET=your_jwt_secret_here
