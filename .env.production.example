# ==============================================================================
# SyncSpace — Production Environment Configuration Example
# ==============================================================================
# Copy this file to backend/.env (or supply via container orchestrator secrets)
# IMPORTANT: Never commit actual credentials or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Runtime & Server Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# Public URL used by clients to reach SyncSpace (behind Nginx reverse proxy)
# Used for CORS and cookie origin validation
CLIENT_URL=http://localhost

# ------------------------------------------------------------------------------
# Authentication Security
# ------------------------------------------------------------------------------
# Strong high-entropy secret for signing JWTs
# NEVER expose this or database credentials in frontend (VITE_*) variables!
JWT_SECRET=replace_with_a_long_random_secure_production_secret

# ------------------------------------------------------------------------------
# Database (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Production connection string pointing to your MongoDB Atlas replica set
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/syncspace?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# Redis Distributed Pub/Sub & Adapter
# ------------------------------------------------------------------------------
# In Docker Compose, backend connects to the internal Redis container
REDIS_URL=redis://redis:6379

# Enforces strict Redis availability. Server aborts startup if Redis is unreachable.
REDIS_REQUIRED=true

# ------------------------------------------------------------------------------
# Frontend Production Build Arguments (Vite)
# ------------------------------------------------------------------------------
# Under the unified Nginx reverse proxy, relative paths allow same-origin routing
VITE_API_URL=/api
VITE_SOCKET_URL=/

